      "name": "Orders",
      "description": {
        "content": "Refund orders placed through Google Play for in-app products and subscriptions.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ad9c93e2-4611-4acd-a824-6d92107e1d34",
          "name": "Refund an Order",
          "request": {
            "name": "Refund an Order",
            "description": {
              "content": "Refunds a user's subscription or in-app purchase order. This initiates a refund through Google Play and the user retains access until the end of the current billing period for subscriptions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "applications",
                ":packageName",
                "orders",
                "{{orderId}}:refund"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "revoke",
                  "value": "<boolean>",
                  "description": "Whether to revoke the purchased item. If true, access to the subscription or in-app product is terminated immediately."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "packageName",
                  "description": "(Required) The package name of the application (e.g., com.example.myapp). This is the unique identifier for the app on Google Play."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
